# =============================================================================
# Root env for Docker Compose (`docker compose` loads this automatically)
# Copy to `.env` and adjust. Never commit real secrets.
# =============================================================================
COMPOSE_PROJECT_NAME=healthcare-hms

# --- Frontend (Docker build-args; Next.js inlines NEXT_PUBLIC_* at build time) ---
NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_APP_NAME=Healthcare HMS
NEXT_PUBLIC_ENV=development

# --- Backend (also used when Compose injects into the backend container) ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DATABASE_URL=jdbc:mysql://127.0.0.1:3306/hms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=root
DATABASE_PASSWORD=
MYSQL_ROOT_PASSWORD=root_password
REDIS_HOST=localhost
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
BACKEND_URL=http://localhost:8080

# JWT — use strong random secrets (≥32 chars) for any shared/staging/prod host.
# Local placeholders are allowed only while JWT_ALLOW_INSECURE_SECRETS=true.
JWT_SECRET=change-me-access-token-secret-key-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-token-secret-key-min-32-chars!
JWT_ALLOW_INSECURE_SECRETS=true
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
JWT_ISSUER=healthcare-hms

PASSWORD_RESET_EXPIRATION=1h
EMAIL_VERIFICATION_EXPIRATION=24h
USER_INVITATION_EXPIRATION=72h

# Email — disabled by default (links logged). Enable for real delivery.
MAIL_ENABLED=false
MAIL_FROM=noreply@healthcare-hms.local
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Multi-tenancy — header X-Tenant-ID is primary
TENANT_SUBDOMAIN_RESOLUTION_ENABLED=false

# Appointment reminders (Phase 6.8)
REMINDERS_ENABLED=true
REMINDERS_SCHEDULER_ENABLED=false
REMINDERS_DISPATCH_CRON=0 */5 * * * *
REMINDERS_BATCH_SIZE=50
REMINDERS_MAX_ATTEMPTS=3
REMINDERS_LEAD_TIMES=24h,1h
REMINDERS_CHANNELS=EMAIL

# Object storage (Phase 7.6) — local filesystem by default; set HMS_STORAGE_TYPE=s3 for MinIO/AWS
HMS_STORAGE_TYPE=local
HMS_STORAGE_LOCAL_PATH=./data/object-storage
HMS_STORAGE_S3_ENDPOINT=http://localhost:9000
HMS_STORAGE_S3_REGION=us-east-1
HMS_STORAGE_S3_BUCKET=hms-clinical
HMS_STORAGE_S3_ACCESS_KEY=minioadmin
HMS_STORAGE_S3_SECRET_KEY=minioadmin
HMS_STORAGE_S3_PATH_STYLE=true

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

MULTIPART_MAX_FILE_SIZE=25MB
MULTIPART_MAX_REQUEST_SIZE=30MB

# Grafana (Compose only — change for any shared environment)
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

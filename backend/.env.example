SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
DATABASE_URL=jdbc:mysql://mysql:3306/hms_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DATABASE_USERNAME=hms_user
DATABASE_PASSWORD=hms_password
REDIS_HOST=redis
REDIS_PORT=6379
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost
JWT_SECRET=change-me-access-token-secret-key-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-token-secret-key-min-32-chars!
JWT_ALLOW_INSECURE_SECRETS=true

# Multi-tenancy — header resolution is always on; subdomain mapping reserved for later.
TENANT_SUBDOMAIN_RESOLUTION_ENABLED=false

# Appointment reminders (Phase 6.8). Scheduler is off by default for local safety.
REMINDERS_ENABLED=true
REMINDERS_SCHEDULER_ENABLED=false
REMINDERS_DISPATCH_CRON=0 */5 * * * *
REMINDERS_BATCH_SIZE=50
REMINDERS_MAX_ATTEMPTS=3
REMINDERS_LEAD_TIMES=24h,1h
REMINDERS_CHANNELS=EMAIL
